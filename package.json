{
  "name": "node-media-server",
  "description": "A Node.js implementation of RTMP Server",
  "version": "4.3.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/illuspas/Node-Media-Server.git"
  },
  "bin": "bin/app.js",
  "main": "src/index.js",
  "files": [
    "bin",
    "src",
    "webadmin/dist"
  ],
  "scripts": {
    "dev": "npx eslint;node bin/app.js",
    "start": "node bin/app.js",
    "build": "npm run build:webadmin",
    "build:webadmin": "npm --prefix webadmin run build",
    "prepublishOnly": "npm run build",
    "test": "node --test test/*.test.js",
    "benchmark": "node --expose-gc benchmark/store.bench.js"
  },
  "keywords": [
    "rtmp",
    "flv",
    "rtmp",
    "livestream",
    "server"
  ],
  "author": "Chen Mingliang",
  "homepage": "https://github.com/illuspas/Node-Media-Server",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-jsdoc": "50.6.0",
    "globals": "^15.12.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-jwt": "^8.5.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
